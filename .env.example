# Copy to .env and fill in. Never commit .env.
# In production these live in a Render environment group, not in a file.

# Phase 1 -------------------------------------------------------------------
# Leave DATABASE_URL empty for local dev and it falls back to SQLite at
# backend/expert_inbox.db. On Render this is set to the Postgres connection
# string automatically by render.yaml.
DATABASE_URL=

# Random string used to sign the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Phase 2 — Microsoft Graph --------------------------------------------------
# Setup steps, including why the app registration gets NO API permissions:
#   docs/azure-setup.md
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MONITORED_MAILBOXES=craigz@expertsvc.com,megan@expertsvc.com,joyce@expertsvc.com,casey@expertsvc.com,info@expertsvc.com

# Where staff forward mail that missed the queue. Kept separate from the list
# above because it's parsed as a forward — the real customer is inside the
# body, not in the From header.
FORWARD_MAILBOX=queue@expertsvc.com

# Outlook category written onto mail we've picked up. Must match the category
# created by hand in each mailbox (azure-setup.md, Part 6) or it shows grey.
# Leave OUTLOOK_CATEGORY empty to turn the tagging off entirely.
OUTLOOK_CATEGORY=Expert Queue
OUTLOOK_CATEGORY_HANDLED=Expert Queue — Handled

# Phase 3 — Classification and drafted replies -------------------------------
ANTHROPIC_API_KEY=

# Phase 4 — ServiceTitan -----------------------------------------------------
SERVICETITAN_CLIENT_ID=
SERVICETITAN_CLIENT_SECRET=
SERVICETITAN_TENANT_ID=
SERVICETITAN_APP_KEY=
